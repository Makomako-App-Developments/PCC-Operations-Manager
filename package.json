{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:field-ops-route-tests": "pnpm --filter @workspace/field-ops run check:route-tests",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run check:field-ops-route-tests && pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@opentelemetry/api": "1.9.1",
      "@vitest/mocker": "4.1.11",
      "@xmldom/xmldom@0.8.13": "0.8.15",
      "@xmldom/xmldom@0.9.10": "0.9.12",
      "baseline-browser-mapping": "2.11.0",
      "body-parser": "2.3.0",
      "brace-expansion": "5.0.9",
      "browserslist": "4.28.7",
      "decode-uri-component": "0.5.0",
      "esbuild": ">=0.28.1",
      "shell-quote": ">=1.9.0",
      "fast-uri": ">=3.1.6",
      "image-size": "2.0.4",
      "ip-address": ">=10.3.1",
      "linkify-it": "5.0.2",
      "lodash": ">=4.18.0",
      "nanoid@3.3.11": "3.3.18",
      "nanoid@3.3.12": "3.3.18",
      "nanoid@5.1.11": "5.1.16",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.23",
      "qs": ">=6.16.0",
      "uuid": ">=11.1.1",
      "vite": "7.3.5",
      "ws": ">=8.21.0",
      "yaml": ">=2.8.3",
      "multer": ">=2.4.0",
      "form-data": ">=4.0.6",
      "markdown-it": ">=14.2.0",
      "@opentelemetry/core": ">=2.8.0",
      "js-yaml": ">=4.3.2",
      "tar": ">=7.5.21",
      "@babel/core": "7.29.6",
      "@expo/cli>undici": "6.28.0",
      "expo-server-sdk>undici": "7.29.0"
    },
    "patchedDependencies": {
      "orval@8.22.0": "patches/orval@8.22.0.patch"
    }
  },
  "dependencies": {
    "docx": "^9.7.1"
  }
}
