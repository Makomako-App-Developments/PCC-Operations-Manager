{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:field-ops-route-tests": "pnpm --filter @workspace/field-ops run check:route-tests",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run check:field-ops-route-tests && pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@opentelemetry/api": "1.9.1",
      "brace-expansion": "5.0.6",
      "esbuild": ">=0.28.1",
      "shell-quote": ">=1.8.4",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "lodash": ">=4.18.0",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2",
      "uuid": ">=11.1.1",
      "vite": "7.3.5",
      "ws": ">=8.21.0",
      "yaml": ">=2.8.3",
      "multer": ">=2.2.0",
      "form-data": ">=4.0.6",
      "markdown-it": ">=14.2.0",
      "@opentelemetry/core": ">=2.8.0",
      "js-yaml": ">=4.2.0",
      "tar": ">=7.5.16",
      "@babel/core": "7.29.6",
      "@expo/cli>undici": "6.27.0",
      "expo-server-sdk>undici": "7.28.0"
    }
  },
  "dependencies": {
    "docx": "^9.7.1"
  }
}
