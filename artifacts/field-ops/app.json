{
  "expo": {
    "name": "GardenOps Field",
    "slug": "field-ops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "field-ops",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "channels": [
        {
          "id": "job-alerts",
          "name": "Job Alerts",
          "importance": 4,
          "sound": "default",
          "vibrate": true
        },
        {
          "id": "digest",
          "name": "Daily Digest",
          "importance": 3,
          "sound": "default"
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "GardenOps Field",
      "shortName": "GardenOps",
      "themeColor": "#166534",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "GardenOps needs access to your photo library to attach evidence to jobs.",
          "cameraPermission": "GardenOps needs camera access to photograph completed work."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/field-ops"
    }
  }
}
